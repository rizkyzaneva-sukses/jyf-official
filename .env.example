# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://elyasr_user:GANTI_PASSWORD@localhost:5432/elyasr_ops"

# ─────────────────────────────────────────────
# SESSION SECRET (iron-session)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────
SESSION_SECRET="GANTI_DENGAN_RANDOM_STRING_32_KARAKTER_MINIMAL"

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="ELYASR Business Operation"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─────────────────────────────────────────────
# ADMIN PASSWORD (untuk seed script pertama kali)
# Jika kosong, seed akan generate random password dan print ke console.
# ─────────────────────────────────────────────
# ADMIN_PASSWORD="your_secure_password_here"

# ─────────────────────────────────────────────
# AI PROVIDERS — 1 Default + 1 Fallback
# Default dipakai duluan. Jika error/gagal → otomatis pakai Fallback.
# Format: OpenAI-compatible (/v1/chat/completions)
# ─────────────────────────────────────────────

# Default — provider utama
ANTIGRAVITY_URL_1="https://myapi.maulanacorp.my.id/v1"
ANTIGRAVITY_KEY_1="GANTI_DENGAN_API_KEY_DEFAULT"
ANTIGRAVITY_MODEL_1="claude-sonnet-4-6"

# Fallback — dipakai jika Default error
ANTIGRAVITY_URL_2="https://lancarapi.maulanacorp.my.id/v1"
ANTIGRAVITY_KEY_2="GANTI_DENGAN_API_KEY_FALLBACK"
ANTIGRAVITY_MODEL_2="claude-sonnet-4-6"

# ─────────────────────────────────────────────
# REPORT API KEY (untuk n8n → Telegram)
# Generate string acak: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ─────────────────────────────────────────────
REPORT_API_KEY="GANTI_DENGAN_RANDOM_SECRET_KEY"

# ─────────────────────────────────────────────
# CRON SECRET (untuk internal auto-report scheduler)
# Digunakan oleh scheduler internal untuk trigger /api/report/cron-telegram
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ─────────────────────────────────────────────
CRON_SECRET="GANTI_DENGAN_RANDOM_SECRET_CRON"

# ─────────────────────────────────────────────
# TELEGRAM BOT (untuk webhook AI assistant)
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="GANTI_DENGAN_BOT_TOKEN_DARI_BOTFATHER"
TELEGRAM_OWNER_CHAT_ID="565228988"
# Bisa multi ID (comma-separated): "565228988,-100123456789"
# Termasuk group chat ID jika bot dipakai di group

# ─────────────────────────────────────────────
# WHATSAPP (WAHA — WhatsApp HTTP API)
# Endpoint WAHA yang sudah running + login session
# ─────────────────────────────────────────────
WAHA_URL="http://localhost:3000"
# Nama session WAHA yang sudah login (lihat di dashboard WAHA)
WAHA_SESSION="default"
# API Key WAHA jika diproteksi (opsional — kosongkan jika tidak pakai)
WAHA_API_KEY=""

